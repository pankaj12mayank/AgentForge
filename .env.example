# Preferred port (first try). If busy, launch.py uses the next free port automatically.
PORT=8765

# Bind host. Keep 127.0.0.1 for local-only access.
# Set to 0.0.0.0 ONLY if you explicitly want LAN access.
HOST=127.0.0.1

# ---- Authentication (ON by default — everyone must register + login) ----
#
# Default: users register their own account (username + password) then sign in.
# To switch to a single shared password instead: APP_AUTH_TOKEN=secret
# (Same value also works as `Authorization: Bearer <token>` for API clients.)
#
# To disable auth entirely for rapid local debugging only:
# APP_AUTH_OFF=1

# Optional: override the SQLite database location.
# PROMPT_GEN_DB_PATH=

# Set to 1 to allow the LLM client to talk to private/LAN servers
# (e.g. a LAN Ollama / LM Studio instance). Default: blocked to avoid key leaks.
# AGENTFORGE_ALLOW_LOCAL_LLM=1

# Set to 1 to skip auto-opening a browser window (headless/server use).
# PROMPT_GEN_NO_BROWSER=1